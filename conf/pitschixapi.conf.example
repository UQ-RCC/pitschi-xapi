[database]
type=postgresql
host=xxxx
username=xxxx
password=xxxx
name=xxxx

[email]
username=xxxx
address=xxxx
password=xxxx
smtp_server=smtp.gmail.com
smtp_port=587

[logging]
log_file=/var/log/pitschi/pitschi-xapi.log

[ppms]
syncing_ppms_project=yes
project_sync_day=7
project_starting_ref=1
syncing_ppms_bookings=yes
booking_sync_minute=5
ppms_url=xxx
api2_key=xxxx
ppms_key=xxxx
q_collection_field=xxxx
coreids=[x,y,z]
timezone=Australia/Brisbane
cores_action=xxxx
systems_action=xxxx
qcollection_action=xxxx
qcollections_action=xxxx
booking_query=xxxx
training_query=xxxx
users_action=xxxx
userids_action=xxxx

[rdm]
prefix=xxxx
cache_defaults={"xxx":a,"yyy":b}

[clowder]
url=xxx
api_url=xxxx/api
api_url_local=http://clowder:9000/api
api_key=xxxx
ingesting=no
ingest_frequency=30
wait_time_to_sync=24

[admin]
admin_username=xxxx
admin_password=xxxx

[keycloak]
server_url=xxxxxxxxxx
realm_name=xxxxxxxxxxx
client_id=xxxxxxxxxxxxxx
client_secret=xxxxxxxxxxxxxxxxx
authorization_url=xxxxxxxxxxxxxxxxx
token_url=xxxxxxxxxxxx
public_key=xxxxxxxxxxx

[creds]
# key using to encrypt credentials - already encrypted using client_key
encrypted_key=xxxx
encrypted_creds=xxxx

[creds.xxx]
# key using to encrypt credentials - already encrypted using client_key
encrypted_key=xxxx
encrypted_creds=xxxx

[templates]
import = xxxx
ingest = xxxx
